# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/niramaya_setu?schema=public

# Redis & Queue Configuration (Optional in local dev, in-memory fallback is active)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ABDM & External Sandbox Stubs (Configure when live credentials available)
ABDM_CLIENT_ID=sandbox_client_id
ABDM_CLIENT_SECRET=sandbox_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway

# AI Provider Stubs (Optional Gemini/Llama API keys)
AI_PROVIDER=stub
AI_API_KEY=

# Marathi Voice Provider Stubs (Optional Bhashini/Indic API keys)
VOICE_PROVIDER=stub
VOICE_API_KEY=
