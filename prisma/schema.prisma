datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ASHA
  ANM
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TriageCategory {
  EMERGENCY_RED
  URGENT_YELLOW
  ROUTINE_GREEN
}

enum FacilityTier {
  SUB_CENTER
  PHC
  CHC
  DISTRICT_HOSPITAL
}

enum ReferralStatus {
  DRAFT
  ISSUED
  IN_TRANSIT
  ACKNOWLEDGED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AlertType {
  REMINDER_24H
  NO_SHOW_ESCALATION_48H
  CRITICAL_TRIAGE_ALERT
}

enum AlertStatus {
  PENDING
  NOTIFIED
  RESOLVED
  ESCALATED
}

enum SyncStatus {
  SYNCED
  PENDING_CONFLICT
  REJECTED
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(ASHA)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  healthWorker HealthWorker?

  @@map("users")
}

model HealthWorker {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  name               String
  mobile             String    @unique
  role               UserRole
  village            String?
  taluka             String?
  district           String?
  assignedFacilityId String?   @map("assigned_facility_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedFacility   Facility? @relation("FacilityWorkers", fields: [assignedFacilityId], references: [id])
  
  registeredPatients Patient[]          @relation("RegisteredPatients")
  triageAssessments  TriageAssessment[] @relation("AssessedByWorker")
  createdReferrals   Referral[]         @relation("OriginatingWorker")
  assignedAlerts     ReferralAlert[]    @relation("TargetWorkerAlerts")

  @@map("health_workers")
}

model Facility {
  id                String       @id @default(uuid())
  name              String
  code              String       @unique
  tier              FacilityTier
  latitude          Float
  longitude         Float
  address           String
  taluka            String?
  district          String
  state             String       @default("Maharashtra")
  pincode           String?
  contactPhone      String?      @map("contact_phone")
  operationalStatus String       @default("ACTIVE") @map("operational_status")
  totalBeds         Int          @default(0) @map("total_beds")
  availableBeds     Int          @default(0) @map("available_beds")
  specialties       String[]     @default([])
  hasEmergencyUnit  Boolean      @default(false) @map("has_emergency_unit")
  hasAmbulance      Boolean      @default(false) @map("has_ambulance")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  workers               HealthWorker[]     @relation("FacilityWorkers")
  originatingReferrals  Referral[]         @relation("OriginatingFacility")
  destinationReferrals  Referral[]         @relation("DestinationFacility")
  registeredPatients    Patient[]          @relation("FacilityPatients")

  @@index([tier])
  @@index([district])
  @@map("facilities")
}

model Patient {
  id                   String        @id @default(uuid())
  clientId             String?       @unique @map("client_id")
  name                 String
  dob                  DateTime
  gender               Gender
  mobile               String?
  village              String
  taluka               String?
  district             String
  address              String?
  
  // Strict Aadhaar Privacy: Tokenized hash & masked only (Never store raw 12 digits)
  aadhaarToken         String?       @unique @map("aadhaar_token")
  maskedAadhaar        String?       @map("masked_aadhaar")
  
  // ABHA Credentials
  abhaNumber           String?       @unique @map("abha_number")
  abhaAddress          String?       @unique @map("abha_address")
  
  registeredById       String?       @map("registered_by_id")
  registeredFacilityId String?       @map("registered_facility_id")
  
  version              Int           @default(1)
  syncStatus           SyncStatus    @default(SYNCED) @map("sync_status")
  syncedAt             DateTime?     @map("synced_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  registeredBy         HealthWorker? @relation("RegisteredPatients", fields: [registeredById], references: [id])
  registeredFacility   Facility?     @relation("FacilityPatients", fields: [registeredFacilityId], references: [id])
  triageAssessments    TriageAssessment[]
  referrals            Referral[]

  @@index([village])
  @@index([mobile])
  @@index([aadhaarToken])
  @@index([abhaNumber])
  @@map("patients")
}

model TriageAssessment {
  id                 String         @id @default(uuid())
  clientId           String?        @unique @map("client_id")
  patientId          String         @map("patient_id")
  assessedById       String?        @map("assessed_by_id")
  
  // Clinical Vitals
  systolicBp         Int?           @map("systolic_bp")
  diastolicBp        Int?           @map("diastolic_bp")
  spo2               Float?
  temperature        Float?
  pulse              Int?
  bloodGlucose       Float?         @map("blood_glucose")
  respiratoryRate    Int?           @map("respiratory_rate")
  
  // Symptoms & Findings (Array of standardized codes/descriptions)
  symptoms           String[]       @default([])
  redFlags           String[]       @default([]) @map("red_flags")
  
  // Triage Outcome
  triageCategory     TriageCategory @map("triage_category")
  clinicalRationale  String         @map("clinical_rationale")
  recommendedTier    FacilityTier   @map("recommended_tier")
  
  evaluatedAt        DateTime       @default(now()) @map("evaluated_at")
  syncedAt           DateTime?      @map("synced_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assessedBy         HealthWorker?  @relation("AssessedByWorker", fields: [assessedById], references: [id])
  referrals          Referral[]

  @@index([patientId])
  @@index([triageCategory])
  @@map("triage_assessments")
}

model Referral {
  id                    String         @id @default(uuid())
  referralCode          String         @unique @map("referral_code")
  clientId              String?        @unique @map("client_id")
  patientId             String         @map("patient_id")
  triageId              String?        @map("triage_id")
  originatingWorkerId   String?        @map("originating_worker_id")
  originatingFacilityId String?        @map("originating_facility_id")
  destinationFacilityId String         @map("destination_facility_id")
  
  specialtyRequired     String         @map("specialty_required")
  urgency               TriageCategory @default(ROUTINE_GREEN)
  clinicalNotes         String?        @map("clinical_notes")
  
  status                ReferralStatus @default(ISSUED)
  
  issuedAt              DateTime       @default(now()) @map("issued_at")
  acknowledgedAt        DateTime?      @map("acknowledged_at")
  completedAt           DateTime?      @map("completed_at")
  cancelledAt           DateTime?      @map("cancelled_at")
  
  // 48-Hour SLA deadline = issuedAt + 48 hours
  slaExpiresAt          DateTime       @map("sla_expires_at")
  
  version               Int            @default(1)
  syncedAt              DateTime?      @map("synced_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  patient               Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  triage                TriageAssessment? @relation(fields: [triageId], references: [id])
  originatingWorker     HealthWorker?  @relation("OriginatingWorker", fields: [originatingWorkerId], references: [id])
  originatingFacility   Facility?      @relation("OriginatingFacility", fields: [originatingFacilityId], references: [id])
  destinationFacility   Facility       @relation("DestinationFacility", fields: [destinationFacilityId], references: [id])
  
  alerts                ReferralAlert[]

  @@index([status])
  @@index([destinationFacilityId])
  @@index([slaExpiresAt])
  @@map("referrals")
}

model ReferralAlert {
  id             String      @id @default(uuid())
  referralId     String      @map("referral_id")
  alertType      AlertType   @map("alert_type")
  targetWorkerId String?     @map("target_worker_id")
  status         AlertStatus @default(PENDING)
  message        String
  triggerAt      DateTime    @map("trigger_at")
  triggeredAt    DateTime?   @map("triggered_at")
  resolvedAt     DateTime?   @map("resolved_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  referral       Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  targetWorker   HealthWorker? @relation("TargetWorkerAlerts", fields: [targetWorkerId], references: [id])

  @@index([referralId])
  @@index([status])
  @@index([triggerAt])
  @@map("referral_alerts")
}

model SyncAuditLog {
  id                String        @id @default(uuid())
  clientMutationId  String        @unique @map("client_mutation_id")
  entityType        String        @map("entity_type")
  entityId          String        @map("entity_id")
  operation         SyncOperation
  clientTimestamp   DateTime      @map("client_timestamp")
  serverTimestamp   DateTime      @default(now()) @map("server_timestamp")
  status            SyncStatus    @default(SYNCED)
  conflictDetails   Json?         @map("conflict_details")
  userId            String?       @map("user_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([clientMutationId])
  @@index([entityType, entityId])
  @@index([serverTimestamp])
  @@map("sync_audit_logs")
}
